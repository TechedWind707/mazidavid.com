{
  "redirects": [
    {
      "source": "/Downloads/(.*)",
      "destination": "/assets/David-Nsofor-Resume.pdf",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/assets/David-Nsofor-Resume.pdf",
      "permanent": false
    },
    {
      "source": "/admin/",
      "missing": [
        {
          "type": "host",
          "value": "work.mazidavid.com"
        }
      ],
      "destination": "https://work.mazidavid.com/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "missing": [
        {
          "type": "host",
          "value": "work.mazidavid.com"
        }
      ],
      "destination": "https://work.mazidavid.com/admin",
      "permanent": false
    },
    {
      "source": "/admin",
      "missing": [
        {
          "type": "host",
          "value": "work.mazidavid.com"
        }
      ],
      "destination": "https://work.mazidavid.com/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "work.mazidavid.com"
        }
      ],
      "destination": "/work/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "me.mazidavid.com"
        }
      ],
      "destination": "/me/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "services.mazidavid.com"
        }
      ],
      "destination": "/services/index.html"
    },
    {
      "source": "/",
      "destination": "/hub/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self' https://gql.hashnode.com https://gallery.mazidavid.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
